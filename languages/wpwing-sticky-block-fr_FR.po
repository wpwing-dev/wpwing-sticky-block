msgid "Fade + Slide"
msgstr "Fondu + Glissement"

#: build/index.js:1
#: src/edit.js:754
msgid "Animation played when the block enters and exits the sticky state."
msgstr "Animation jouée lorsque le bloc entre et sort de l'état collant."

#: build/index.js:1
#: src/edit.js:765
msgid "Transition duration (ms)"
msgstr "Durée de la transition (ms)"

#: build/index.js:1
#: src/edit.js:775
msgid "How long the entry animation takes in milliseconds."
msgstr "Durée de l'animation d'entrée en millisecondes."

#: build/index.js:1
#: src/edit.js:783
msgid "Transition easing"
msgstr "Courbe de transition"

#: build/index.js:1
#: src/edit.js:786
msgid "Ease (default)"
msgstr "Ease (par défaut)"

#: build/index.js:1
#: src/edit.js:787
msgid "Ease in"
msgstr "Ease in"

#: build/index.js:1
#: src/edit.js:788
msgid "Ease out"
msgstr "Ease out"

#: build/index.js:1
#: src/edit.js:789
msgid "Ease in-out"
msgstr "Ease in-out"

#: build/index.js:1
#: src/edit.js:790
msgid "Linear"
msgstr "Linéaire"

#: build/index.js:1
#: src/edit.js:795
msgid "Controls the acceleration curve of the animation."
msgstr "Contrôle la courbe d'accélération de l'animation."

#: build/index.js:1
#: src/edit.js:806
msgid "Accessibility"
msgstr "Accessibilité"

#: build/index.js:1
#: src/edit.js:811
msgid "ARIA label"
msgstr "Étiquette ARIA"

#: build/index.js:1
#: src/edit.js:813
msgid "e.g. Site navigation"
msgstr "ex. Navigation du site"

#: build/index.js:1
#: src/edit.js:817
msgid "Adds an aria-label attribute to the sticky wrapper, improving screen reader context. Leave blank to omit."
msgstr "Ajoute un attribut aria-label au conteneur collant, améliorant le contexte pour les lecteurs d'écran. Laissez vide pour l'omettre."

#: build/index.js:1
#: src/edit.js:826
msgid "Advanced"
msgstr "Avancé"

#: build/index.js:1
#: src/edit.js:831
msgid "CSS class when sticky"
msgstr "Classe CSS lorsque collant"

#: build/index.js:1
#: src/edit.js:837
msgid "Extra CSS classes added to the block when it is sticky. Separate multiple classes with spaces."
msgstr "Classes CSS supplémentaires ajoutées au bloc lorsqu'il est collant. Séparez plusieurs classes par des espaces."

#: build/index.js:1
